---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_TITLE } from "../../consts";
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description="My Projects" />
  </head>
  <body>
    <Header />
    <main class="projects-main">
      <h1 class="projects-title">My Projects</h1>
    </main>
    <Footer />
  </body>
</html>

<style>
  .projects-main {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 4em 1em;
  }

  .projects-title {
    font-family: var(--font-ligema), serif;
    font-size: 3rem;
    font-weight: 400;
    color: #ffffff;
    margin: 0;
  }
</style>