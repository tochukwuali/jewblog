---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import CloudinaryImage from "../../components/CloudinaryImage.astro";
import { SITE_TITLE } from "../../consts";
import { projects, type Project } from "../../data/projects";

const PROJECTS_PER_PAGE = 4;
const totalPages = Math.ceil(projects.length / PROJECTS_PER_PAGE);

const paginatedProjects: Project[][] = Array.from({ length: totalPages }, (_, i) =>
  projects.slice(i * PROJECTS_PER_PAGE, (i + 1) * PROJECTS_PER_PAGE)
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description="My Projects" />
  </head>
  <body>
    <Header />
    <main class="projects-main">
      <h1 class="projects-title font-ligema">My PrOJeCTS</h1>

      <div class="projects-filters">
        <button class="filter-pill active" data-filter="all">All</button>
        <button class="filter-pill" data-filter="youtube">Youtube</button>
        <button class="filter-pill" data-filter="books">Books</button>
      </div>

      <p class="projects-date-range">2021-2025</p>

      <!-- All pages rendered, JS shows only current page -->
      {
        paginatedProjects.map((pageItems, pageIdx) => (
          <div
            class={`projects-grid${pageIdx === 0 ? " active" : ""}`}
            data-page={pageIdx}
          >
            {pageItems.map((project) => (
              <a
                href={`/projects/${project.slug}`}
                class="project-card"
                data-category={project.category}
              >
                <CloudinaryImage
                  class="project-card-img"
                  src={project.image}
                  alt={project.title}
                />
                <div class="project-card-body">
                  <div class="project-card-title-row">
                    <span class="project-card-title font-ligema">{project.title.toUpperCase()}</span>
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 16 16"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M4.5 2.5L13.5 2.5M13.5 2.5L13.5 11.5M13.5 2.5L2.5 13.5"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </div>
                  <div class="project-card-tags">
                    {project.tags.map((tag) => (
                      <span class="project-tag">{tag}</span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        ))
      }

      {
        totalPages > 1 && (
          <div class="pagination" id="projects-pagination">
            <button class="pagination-btn prev disabled" data-dir="prev">← Previous</button>
            <span class="pagination-current" id="pagination-current">1 / {totalPages}</span>
            <button class="pagination-btn next" data-dir="next">Next →</button>
          </div>
        )
      }
    </main>
    <Footer />
  </body>
</html>

<style>
  .projects-main {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 1em;
  }

  .projects-title {
    font-family: var(--font-ligema), serif;
    font-size: 56px;
    font-weight: 400;
    color: rgb(var(--black));
    margin: 0 0 1.5rem 0;
    text-align: center;
  }

  /* ---- Filter pills ---- */
  .projects-filters {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .filter-pill {
    font-family: inherit;
    text-transform: uppercase;
    font-size: 14px;
    font-weight: 400;
    padding: 0.5rem 1.5rem;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    background: rgb(var(--gray-light));
    color: var(--muted);
  }

  .filter-pill.active {
    background: rgba(212, 237, 109, 1);
    color: #000;
  }

  .filter-pill:not(.active):hover {
    background: rgba(var(--gray), 0.6);
  }

  /* ---- Date range ---- */
  .projects-date-range {
    text-align: right;
    font-size: 14px;
    color: var(--muted);
    margin: 0 0 2rem 0;
  }

  /* ---- Grid ---- */
  .projects-grid {
    display: none;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .projects-grid.active {
    display: grid;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.2s;
  }

  .project-card:hover {
    transform: translateY(-3px);
  }

  .project-card-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 16px 16px 0 0;
    display: block;
  }

  .project-card-body {
    padding: 1.25rem 0 0;
  }

  .project-card-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.75rem;
    gap: 0.5rem;
  }

  .project-card-title {
    font-size: 20px;
    font-weight: 400;
    font-family: var(--font-ligema), serif;
    color: rgb(var(--black));
    line-height: 1.15;
    text-transform: uppercase;
  }

  .project-card-title-row svg {
    flex-shrink: 0;
    color: var(--muted);
    margin-top: 2px;
  }

  .project-card-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .project-tag {
    font-size: 12px;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: rgb(var(--gray-light));
    color: var(--text);
  }

  /* ---- Pagination ---- */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin-top: 3rem;
  }

  .pagination-btn {
    font-family: inherit;
    font-size: 14px;
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s;
  }

  .pagination-btn.disabled {
    opacity: 0.3;
    pointer-events: none;
    cursor: default;
  }

  .pagination-btn:not(.disabled):hover {
    color: rgb(var(--black));
  }

  .pagination-current {
    font-size: 14px;
    color: var(--muted);
  }

  /* ---- Mobile ---- */
  @media (min-width: 769px) {
    .projects-title {
      font-size: 40px;
    }
  }

  @media (max-width: 768px) {
    .projects-date-range {
      text-align: left;
    }

    .projects-grid.active {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .project-card-title {
      font-size: 24px;
      letter-spacing: 1px;
    }
  }
</style>

<script>
  (() => {
    const grids = document.querySelectorAll<HTMLElement>(".projects-grid");
    const prevBtn = document.querySelector<HTMLButtonElement>(".pagination-btn.prev");
    const nextBtn = document.querySelector<HTMLButtonElement>(".pagination-btn.next");
    const pageLabel = document.getElementById("pagination-current");
    const pills = document.querySelectorAll<HTMLButtonElement>(".filter-pill");
    const allCards = document.querySelectorAll<HTMLElement>(".project-card");

    let activePage = 0;
    const totalPages = grids.length;

    function showPage(idx: number) {
      grids.forEach((g) => {
        g.classList.toggle("active", Number(g.dataset.page) === idx);
      });
      if (prevBtn) prevBtn.classList.toggle("disabled", idx === 0);
      if (nextBtn) nextBtn.classList.toggle("disabled", idx === totalPages - 1);
      if (pageLabel) pageLabel.textContent = `${idx + 1} / ${totalPages}`;
      activePage = idx;
    }

    prevBtn?.addEventListener("click", () => {
      if (activePage > 0) showPage(activePage - 1);
    });

    nextBtn?.addEventListener("click", () => {
      if (activePage < totalPages - 1) showPage(activePage + 1);
    });

    /* Filter */
    pills.forEach((pill) => {
      pill.addEventListener("click", () => {
        pills.forEach((p) => p.classList.remove("active"));
        pill.classList.add("active");

        const filter = pill.dataset.filter ?? "all";

        allCards.forEach((card) => {
          const category = card.dataset.category;
          if (filter === "all" || category === filter) {
            card.style.display = "";
          } else {
            card.style.display = "none";
          }
        });
      });
    });

    showPage(0);
  })();
</script>
 