---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import CloudinaryImage from "../../components/CloudinaryImage.astro";
import { SITE_TITLE } from "../../consts";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = projects.find((p) => p.slug === slug);

if (!project) {
  return Astro.redirect("/projects");
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${project.title} | ${SITE_TITLE}`} description={project.title} />
  </head>
  <body>
    <Header />
    <main class="project-detail-main">
      <a href="/projects" class="back-link">
        <svg
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M11.5 3.5L5.5 9L11.5 14.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        Back to Projects
      </a>

      <article class="project-article">
        <CloudinaryImage
          class="project-hero-img"
          src={project.image}
          alt={project.title}
          widths={[640, 960, 1280, 1920]}
        />

        <div class="project-meta">
          {project.tags.map((tag) => (
            <span class="project-tag">{tag}</span>
          ))}
        </div>

        <h1 class="project-detail-title font-ligema">{project.title.toUpperCase()}</h1>

        {
          project.role && (
            <div class="project-detail-section">
              <h2 class="section-heading">Role</h2>
              <p class="section-text">{project.role}</p>
            </div>
          )
        }

        {
          project.video && (
            <div class="project-detail-section">
              <h2 class="section-heading">Video</h2>
              <p class="section-text">{project.video}</p>
            </div>
          )
        }

        {
          project.contribution && project.contribution.length > 0 && (
            <div class="project-detail-section">
              <h2 class="section-heading">My Contribution</h2>
              <ul class="contribution-list">
                {project.contribution.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )
        }

        {
          project.results && (
            <div class="project-detail-section">
              <h2 class="section-heading">Results</h2>
              <p class="section-text results-text">{project.results}</p>
            </div>
          )
        }

        {
          project.whyChosen && (
            <div class="project-detail-section">
              <h2 class="section-heading">Why I Chose This Sample</h2>
              <p class="section-text">{project.whyChosen}</p>
            </div>
          )
        }

        {
          project.link && (
            <a href={project.link} target="_blank" rel="noopener noreferrer" class="view-link">
              Watch Video
              <svg
                width="18"
                height="18"
                viewBox="0 0 18 18"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M13.5 9L6.5 3.5V14.5L13.5 9Z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          )
        }
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .project-detail-main {
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    padding: 4em 1em;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 15px;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: rgb(var(--black));
  }

  .project-article {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .project-hero-img {
    width: 100%;
    border-radius: 16px;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .project-meta {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .project-tag {
    font-size: 12px;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: rgb(var(--gray-light));
    color: var(--text);
  }

  .project-detail-title {
    font-size: 32px;
    font-weight: 400;
    color: rgb(var(--black));
    line-height: 1.15;
    margin: 0;
    text-transform: uppercase;
  }

  .project-detail-section {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .section-heading {
    font-size: 16px;
    font-weight: 600;
    color: rgb(var(--black));
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .section-text {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text);
    margin: 0;
  }

  .results-text {
    font-size: 20px;
    font-weight: 600;
    color: rgb(var(--accent));
  }

  .contribution-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .contribution-list li {
    font-size: 15px;
    color: var(--text);
    padding-left: 1.2rem;
    position: relative;
  }

  .contribution-list li::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--muted);
  }

  .view-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.75rem 1.5rem;
    background: rgb(var(--gray-dark));
    color: rgb(var(--gray-light));
    text-decoration: none;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    transition: background 0.2s;
    align-self: flex-start;
  }

  .view-link:hover {
    background: rgb(var(--black));
  }

  @media (max-width: 768px) {
    .project-detail-title {
      font-size: 24px;
      letter-spacing: 2px;
    }

    .project-detail-main {
      padding: 2em 1em;
    }
  }
</style>
