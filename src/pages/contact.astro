<style>
  /* --- Overall dark background --- */
  body {
    background: #0d0d0d;
    color: #e0e0e0;
    margin: 0;
    padding: 0;
  }

  /* Override Astro's default main width */
  .contact-main {
    width: 100% !important;
    max-width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  /* --- Hero Section --- */
  .hero-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: flex-start;
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem 2rem;
  }

  /* --- Left Column --- */
  .hero-left {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 1rem;
  }

  .jewbelee {
    color: rgba(212, 237, 109, 1);
  }

  .hero-heading {
    font-family: var(--font-ligema), serif;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 400;
    line-height: 0.95;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .hero-subtext,
  .hero-email-prefix {
    font-family: var(--font-primary), sans-serif;
    font-size: 18px;
    line-height: 1.6;
    color: #b0b0b0;
    margin: 0;
  }

  .hero-subtext {
    margin-bottom: 0.5rem;
  }

  .email-badge {
    display: inline-block;
    background: rgba(212, 237, 109, 1);
    color: #000;
    text-decoration: none;
    font-family: var(--font-primary), sans-serif;
    font-size: 16px;
    font-weight: 400;
    padding: 0.15rem 1.5rem;
    border-radius: 50px;
    align-self: flex-start;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .email-badge:hover {
    background: #00c853;
    transform: translateY(-1px);
  }

  /* --- Right Column --- */
  .hero-right {
    width: 100%;
  }

  /* --- Social Section --- */
  .social-section {
    max-width: 900px;
    margin: 3rem auto;
    padding: 2rem 2rem 4rem;
    text-align: center;
  }

  .social-heading {
    font-family: var(--font-primary), sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 3px;
    color: #888;
    margin-bottom: 2.5rem;
  }

  .social-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
    max-width: 750px;
    margin: 0 auto;
  }

  .social-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 50px;
    padding: 0.8rem 1.5rem;
    text-decoration: none;
    color: #d0d0d0;
    font-family: var(--font-primary), sans-serif;
    font-size: 15px;
    font-weight: 500;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
  }

  .social-btn:hover {
    background: #252525;
    border-color: #00e676;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .social-icon {
    display: flex;
    align-items: center;
    color: #00e676;
  }

  .social-icon svg {
    width: 20px;
    height: 20px;
  }

  /* --- Footer --- */
  .contact-footer {
    border-top: 1px solid #1a1a1a;
    padding: 1.5rem 2rem;
    font-family: var(--font-primary), sans-serif;
    font-size: 13px;
    color: #777;
    background: #0d0d0d;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-links a {
    color: #999;
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: #00e676;
  }

  /* --- Responsive: mobile stacking at 768px --- */
  @media (max-width: 768px) {
    .hero-section {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 2rem 1.25rem 1.5rem;
    }

    .hero-left {
      order: 0;
      /* text-align: center;
      align-items: center; */
    }

    .hero-right {
      order: 1;
    }

    .hero-heading {
      font-size: 3.5rem;
      font-weight: 400;
      line-height: 1.1;
      letter-spacing: 0.02em;
    }

    .hero-subtext {
    font-size: 16px;
  }

    .hero-email-prefix {
      font-size: 16px;
    }

    .social-grid {
      grid-template-columns: 1fr;
    }

    .social-section {
      padding: 1.5rem 1.25rem 3rem;
    }

    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>