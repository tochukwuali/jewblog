---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import LoadableImage from "../components/LoadableImage.astro";
import LoadingScreen from "../components/LoadingScreen.astro";
import WaveDivider from "../components/WaveDivider.astro";
import { SITE_TITLE } from "../consts";
import HeroAbout from "../assets/jewblog_hero_about.png";
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description="About Jubilee.." />
  </head>
  <body class="loading-screen-active">
    <LoadingScreen />
    <Header />
    <main class="about-main">
      <!-- Hero Section -->
      <section class="about-section">
        <!-- Left Column -->
        <div class="hero-heading">
          <h1 class="hero-heading-text">
            AN ADaPTIVE STOrYTELLER WITH DEeP PaSSION FoR SToRYTeLLIING
          </h1>

          <div class={"hero-image"}>
            <LoadableImage
              class="home-hero-img"
              src={HeroAbout}
              alt={"Jubilee"}
              loading="eager"
              spinner
            />
          </div>
        </div>

        <!-- Right Column: Form -->
        <div class="hero-right">
          <!-- <ContactForm /> -->
        </div>
      </section>

      <!-- Wave Divider -->
      <!-- <WaveDivider /> -->

      <!-- Social Links Section -->
    </main>

    <Footer />
  </body>
</html>

<style>

  main {
    padding: 1em 0 !important;
  }
  .about-main {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto;
  }
  .hero-heading {
    text-align: center;
    padding: 1em 0;
    width: 100%;
  }

  .hero-heading-text {
    font-size: 2.8rem;
    font-family: var(--font-ligema), serif;
    font-weight: 400;
    line-height: 0.95;
    color: #ffffff;
    margin: 0;
    /* letter-spacing: 0.05em; */
    align-items: center;
  }

  .hero-image {
    margin-top: 2em;
    background-image: url("../assets/squiggly-bg.svg");
    background-repeat: no-repeat;
    background-size: cover;
    padding: 0 !important;
    /* margin: 0 auto !important; */
    max-width: 100% !important;
  }
</style>
