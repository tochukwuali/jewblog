---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import LoadableImage from "../components/LoadableImage.astro";
import LoadingScreen from "../components/LoadingScreen.astro";
import WaveDivider from "../components/WaveDivider.astro";
import { SITE_TITLE } from "../consts";
import HeroAbout from "../assets/jewblog_hero_about.png";
import JewChilling from "../assets/jewchilling.jpg";
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description="About Jubilee.." />
  </head>
  <body class="loading-screen-active">
    <LoadingScreen />
    <Header />
    <main class="about-main">
      <!-- Hero Section -->
      <section class="about-section">
        <!-- Left Column -->
        <div class="hero-heading">
          <h1 class="hero-heading-text">
            AN ADaPTIVE STOrYTELLER WITH DEeP PaSSION FoR SToRYTeLLIING
          </h1>

          <div class={"hero-image"}>
            <LoadableImage
              class="about-hero-img"
              src={HeroAbout}
              alt={"Jubilee"}
              loading="eager"
              spinner
            />
          </div>
        </div>

        <!-- Right Column: Form -->
        <div class="hero-right">
          <!-- <ContactForm /> -->
        </div>
      </section>

      <!-- Wave Divider -->
      <!-- <WaveDivider /> -->

      <!-- ABOUT ME Section -->
      <section class="about-me-section">
        <h2 class="section-title">ABOUT ME</h2>
        <div class="about-me-content">
          <p>
            I'm Jubilee Edeh — a Nigerian creative writer, storyteller, and
            occasional sales whisperer. My journey into storytelling began long
            before I had the words to describe it, in the quiet corners of my
            childhood where I discovered that words could build worlds, shift
            perspectives, and make people feel seen.
          </p>
          <div class="about-me-image">
            <LoadableImage
              src={JewChilling}
              alt="Jubilee"
              loading="lazy"
              spinner
            />
          </div>
          <p>
            Over the years, I've written for YouTube channels, collaborated with
            brands, and explored the intersecting spaces between creative writing,
            business development, and product design. But at my core, I remain a
            writer first — someone who believes that a well-told story can change
            the trajectory of a conversation, a brand, or even a life. When I'm not
            crafting narratives, you'll find me studying the art of great
            storytelling, obsessing over shawarma, or plotting my next creative
            adventure.
          </p>
        </div>
      </section>

      <!-- PAST ACHIEVEMENTS Section -->
      <section class="timeline-section">
        <h2 class="section-title">PAST ACHIEVEMENTS</h2>
        <div class="timeline-list">
          <div class="timeline-card">
            <div class="timeline-year">2024</div>
            <div class="timeline-content">
              <ul>
                <li>Published a collection of short stories exploring modern Nigerian identity, receiving critical acclaim from local literary circles.</li>
                <li>Led a creative writing workshop for 50+ aspiring writers, fostering new voices in African storytelling.</li>
              </ul>
            </div>
          </div>
          <div class="timeline-card">
            <div class="timeline-year">2023</div>
            <div class="timeline-content">
              <ul>
                <!-- <li>Featured as a keynote speaker at the annual Lagos Storytelling Festival, addressing an audience of over 500 attendees.</li> -->
                <li>Completed a commissioned screenplay for an independent film project that premiered at an international film festival.</li>
              </ul>
            </div>
          </div>
          <div class="timeline-card">
            <div class="timeline-year">2022</div>
            <div class="timeline-content">
              <ul>
                <li>Launched a personal blog that grew to 10,000+ monthly readers within six months of its debut.</li>
                <!-- <li>Won the Emerging Writer Award at the Nigerian Writers' Guild annual conference.</li> -->
              </ul>
            </div>
          </div>
          <div class="timeline-card">
            <div class="timeline-year">2021</div>
            <div class="timeline-content">
              <ul>
                <!-- <li>Graduated with honors in English and Literary Studies, earning a distinction for a thesis on contemporary African prose.</li> -->
                <li>Published first feature article in a nationally circulated magazine, covering youth culture and creative expression.</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- WORK HISTORY Section -->
      <section class="timeline-section">
        <h2 class="section-title">WORK HISTORY</h2>
        <div class="timeline-list">
          <div class="timeline-card work-card">
            <div class="timeline-year">2024</div>
            <div class="timeline-employer">Tayo Aina</div>
            <div class="timeline-role">Script Writer</div>
          </div>
          <div class="timeline-card work-card">
            <div class="timeline-year">2024</div>
            <div class="timeline-employer">Tenece Professional Services</div>
            <div class="timeline-role">Business Developer</div>
          </div>
          <div class="timeline-card work-card">
            <div class="timeline-year">2024</div>
            <div class="timeline-employer">Genesys Tech Hub</div>
            <div class="timeline-role">Product Design Intern</div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>

  main {
    padding: 1em 0 !important;
  }
  .about-main {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto;
  }
  .hero-heading {
    text-align: center;
    padding: 1em 0;
    width: 100%;
  }

  .hero-heading-text {
    font-size: 3rem;
    font-family: var(--font-ligema), serif;
    font-weight: 400;
    line-height: 0.95;
    color: var(--text);
    margin: 0;
    /* letter-spacing: 0.05em; */
    align-items: center;
    width: 100%;
    padding: 0 1em;
  }

  .hero-image {
    margin-top: 2em;
    background-image: url("../assets/squiggly-bg.svg");
    background-repeat: no-repeat;
    background-size: cover;
    padding: 0 !important;
    max-width: 100% !important;
    display: flex;
    justify-content: center;
  }

  .about-hero-img .loadimg__img {
    max-height: none;
    width: 100%;
    object-fit: cover;
  }

  /* ===== About Me Section ===== */
  .about-me-section {
    width: 100%;
    max-width: 1300px;
    margin: 3em auto 2em;
    padding: 0 1em;
  }

  .about-me-content p {
    font-size: 16px;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 1.5em;
  }

  .about-me-image {
    margin: 2em 0;
    border-radius: 12px;
    overflow: hidden;
  }

  .about-me-image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    object-fit: cover;
  }

  /* ===== Timeline Sections (Past Achievements & Work History) ===== */
  .timeline-section {
    width: 100%;
    max-width: 1300px;
    margin: 3em auto 2em;
    padding: 0 1em;
  }

  .section-title {
    font-family: var(--font-ligema), serif;
    font-size: 32px;
    font-weight: 400;
    color: var(--gray);
    margin-bottom: 1.5em;
    text-align: left;
    letter-spacing: 0.03em;
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 1em;
  }

  .timeline-card {
    background: var(--about-content-card);
    border-radius: 16px;
    padding: 2em 2em 1.5em;
    display: flex;
    align-items: flex-start;
    gap: 2em;
  }

  .timeline-year {
    flex-shrink: 0;
    width: 80px;
    /* font-family: var(--font-ligema), serif; */
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--about-content-gray);
    line-height: 1.3;
  }

  .timeline-content {
    flex: 1;
  }

  .timeline-content ul {
    list-style: disc;
    padding-left: 1.5em;
    margin: 0;
  }

  .timeline-content ul li {
    color: var(--about-content-list-items);
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 0.4em;
    /* font-weight: 500; */
  }

  .timeline-content ul li:last-child {
    margin-bottom: 0;
  }

  /* Work History specific styles */
  .work-card {
    align-items: center;
  }

  .timeline-employer {
    flex: 1;
    color: var(--about-content-gray);
    font-size: 16px;
    font-weight: 500;
  }

  .timeline-role {
    flex-shrink: 0;
    color: var(--muted);
    font-size: 16px;
    /* font-style: italic; */
    text-align: right;
    font-weight: 500;
    min-width: 160px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .about-main {
      padding: 0 !important;
    }

    .hero-image {
      margin-top: 1em;
      width: 100vw;
      margin-left: calc(-50vw + 50%);
    }

    .hero-heading-text {
      font-size: 2rem;
      padding: 0 1em;
    }

    .about-hero-img .loadimg__img {
      border-radius: 0;
    }

    .timeline-section {
      padding: 0 0.75em;
      margin: 2em auto 1.5em;
    }

    .section-title {
      font-size: 32px;
      margin-bottom: 1em;
    }

    .timeline-card {
      padding: 1.25em 1em 1em;
      flex-direction: column;
      gap: 0.5em;
    }

    .timeline-year {
      width: auto;
      font-size: 1.25rem;
    }

    .timeline-content ul {
      padding-left: 1.25em;
    }

    .timeline-content ul li {
      font-size: 16px;
    }

    .work-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3em;
    }

    .timeline-role {
      text-align: left;
    }
  }
</style>
