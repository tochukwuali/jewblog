---
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Button from "../components/Button.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import hero from "../assets/jewblog_hero.jpg";
import JewChilling from "../assets/jewchilling.jpg";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <h1 class="header1">Jubilee Edeh</h1>
      <div style="margin: 2em 0;" class="header-buttons">
        <Button
          href="/blog"
          rounded
          background="rgba(244, 184, 75, 1)"
          class="btn-items"
          variant="primary">CREATIVE WRITER</Button
        >
        <Button
          href="/blog"
          rounded
          class="btn-items"
          background="rgba(212, 237, 109, 1)"
          variant="primary">ADAPTIVE STORYTELLER</Button
        >
      </div>
      <div class={"hero-image"}>
        <Image src={hero} alt={"Jubilee"} />
      </div>
      <div>
        <p>
          Hey hey, I'm Jubilee 👋 <br /> Wordsmith by birth, sales whisperer by hustle,
          product design dabbler only by curiosity, and failed content creator.
        </p>
        <p>
          Whatever brought you here—fate, SEO, or a wrong turn—I’ve got a clever
          fix and a perfect idea with your name on it.
        </p>
      </div>

      <div class="width: 100%">
        <Button rounded background="#fff" class="full-width">
          Watch my hello video
        </Button>
      </div>

      <div class={"jewchilling-img"}>
        <Image src={JewChilling} alt={"Jubilee"} />
      </div>
    </main>
    <Footer />
	 <style>
    .hero-image {
      max-height: 24rem;
      overflow: hidden;
      border-radius: 8px;
    }

    .hero-image img {
      width: 100% !important;
      height: auto !important;
      /* object-fit: contain; */
      display: block;
    }

    .header-buttons {
      display: flex;
      justify-content: space-between;
    }

    .header-buttons button,
    .header-buttons .btn-items {
      text-transform: uppercase;
    }

    .btn-items {
      text-transform: uppercase;
    }

	.jewchilling-img {
		margin-top: 4rem;
	}
  </style>
  </body>
</html>
