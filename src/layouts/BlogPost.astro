---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import Button from "../components/Button.astro";
import LoadableImage from "../components/LoadableImage.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, pubDate, description, heroImage } = Astro.props;

---
<html lang="en">
  <head>
    <BaseHead title={title} />
    <style>
      main {
        width: calc(100% - 2em);
        max-width: 100%;
        margin: 0;
      }
      .hero-image {
        width: 100%;
      }
      .hero-img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }
      .prose {
        width: 720px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: rgb(var(--gray-dark));
      }
      .title {
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: left;
        line-height: 1;
      }
      .title h1 {
        margin: 0 0 0.5em 0;
        font-size: 24px;
      }
      .back-button-container {
        max-width: 100%;
        margin: 0 0 1em 0;
      }
      .back-button-container a {
        display: inline-block;
		font-size: 12px !important;
      }
      .date {
        margin-bottom: 0.5em;
        color: rgb(var(--gray));
      }
      .last-updated-on {
        font-style: italic;
      }
      @media (max-width: 720px) {
        .prose {
          width: 100%;
          max-width: calc(100% - 0.5em);
          padding: 1rem 0;
          margin: auto;
        }
        .prose p {
          font-size: 14px;
        }
        .title {
          padding: 0.5em 0;
        }
        .title h1 {
          font-size: 20px;
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <div class="back-button-container">
        <Button href="/blog" class="back-btn" rounded variant="outline">
          <svg
            slot="iconBefore"
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M7.97508 4.94167L2.91675 10L7.97508 15.0583"
              stroke="#CDD1D6"
              stroke-width="1.5"
              stroke-miterlimit="10"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M17.0833 10L3.05835 10"
              stroke="#CDD1D6"
              stroke-width="1.5"
              stroke-miterlimit="10"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>

          Back
        </Button>
      </div>
      <article>
        {
          heroImage && (
            <div class="hero-image">
              <LoadableImage
                class="hero-img"
                width={1020}
                height={510}
                src={heroImage}
                alt={title}
                loading="eager"
                spinner
              />
            </div>
          )
        }
        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={pubDate} />
              <!-- {
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							} -->
            </div>
            <h1>{title}</h1>
            <hr />
          </div>
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
