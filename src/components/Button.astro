---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "outline";
  class?: string;
  background?: string;
  rounded?: boolean;
}

const {
  href,
  variant = "primary",
  class: className,
  background,
  rounded = false,
} = Astro.props;
const Component = href ? "a" : "button";
const attributes = href ? { href } : {};
const style = background
  ? `background-color: ${background}; border-color: ${background};`
  : "";
---

<Component
  {...attributes}
  class={`btn btn-${variant} ${rounded ? "btn-rounded" : ""} ${className || ""}`}
  style={style}
>
  <span class="btn-content">
    <slot name="iconBefore" />
    <span class="btn-label"><slot /></span>
    <slot name="iconAfter" />
  </span>
</Component>

<style>
  .btn {
    padding: 0.35em 1.5em;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    font-weight: 400;
  }

  /* Allow custom classes to override button styles */
  .btn[class*="custom-"],
  .btn[class*="my-"] {
    /* Custom classes can override these */
  }

  .btn-content {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
  }

  .btn-label {
    display: inline-flex;
    align-items: center;
  }

  .btn-primary {
    background-color: var(--accent);
    color: var(--overlay-bg);
    border: 2px solid var(--accent);
  }

  .btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .btn-secondary {
    background-color: var(--text);
    color: var(--overlay-bg);
    border: 1px solid var(--text);
  }

  .btn-secondary:hover {
    opacity: 0.8;
    transform: translateY(-2px);
  }

  .btn-outline {
    background-color: transparent;
    color: var(--text);
    border: 1px solid var(--text);
    font-weight: 400;
  }

  .btn-outline:hover {
    background-color: var(--text);
    color: var(--overlay-bg);
  }

  .btn-rounded {
    border-radius: 999px;
  }

  a.btn {
    text-decoration: none;
  }

  a.btn:hover {
    text-decoration: none;
  }
</style>
