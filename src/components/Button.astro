---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "outline";
  class?: string;
  background?: string;
  rounded?: boolean;
}

const {
  href,
  variant = "primary",
  class: className,
  background,
  rounded = false,
} = Astro.props;
const Component = href ? "a" : "button";
const attributes = href ? { href } : {};
const style = background
  ? `background-color: ${background}; border-color: ${background};`
  : "";
---

<Component
  {...attributes}
  class={`btn btn-${variant} ${rounded ? "btn-rounded" : ""} ${className || ""}`}
  style={style}
>
  <slot />
</Component>

<style>
  .btn {
    padding: 0.35em 1.5em;
    border: none;
    border-radius: 6px;
    /* font-size: 20px; */
    /* font-family: var(--font-primary), sans-serif; */
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s ease;
    font-weight: 600;
  }

  .btn-primary {
    background-color: var(--accent);
    color: var(--overlay-bg);
    border: 2px solid var(--accent);
  }

  .btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .btn-secondary {
    background-color: var(--text);
    color: var(--overlay-bg);
    border: 2px solid var(--text);
  }

  .btn-secondary:hover {
    opacity: 0.8;
    transform: translateY(-2px);
  }

  .btn-outline {
    background-color: transparent;
    color: var(--accent);
    border: 2px solid var(--accent);
  }

  .btn-outline:hover {
    background-color: var(--accent);
    color: var(--overlay-bg);
  }

  .btn-rounded {
    border-radius: 999px;
  }

  a.btn {
    text-decoration: none;
  }

  a.btn:hover {
    text-decoration: none;
  }
</style>
