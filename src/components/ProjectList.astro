---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import LoadableImage from "./LoadableImage.astro";

interface Props {
  posts: CollectionEntry<"blog">[];
  currentPage: number;
  totalPages: number;
}

const { posts, currentPage, totalPages } = Astro.props;
---

<style>
  .project-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    list-style-type: none;
    margin: 0;
    padding: 0;
  }
  .project-grid li {
    width: calc(50% - 1rem);
  }
  .project-grid li * {
    text-decoration: none;
    transition: 0.2s ease;
  }
  .project-grid li:first-child {
    width: 100%;
    margin-bottom: 1rem;
    text-align: center;
  }
  .project-grid li:first-child .project-thumb {
    width: 100%;
  }
  .project-grid li:first-child .title {
    font-size: 2.369rem;
  }
  .project-grid li .project-thumb {
    margin-bottom: 0.5rem;
    border-radius: 12px;
  }
  .project-grid li a {
    display: block;
  }
  .title {
    margin: 0;
    color: rgb(var(--black));
    line-height: 1;
    font-size: 32px;
    font-weight: 400;
  }
  .date {
    margin: 0;
    color: rgb(var(--gray));
    font-size: 14px;
  }
  .project-grid li a:hover .title,
  .project-grid li a:hover .date {
    color: rgb(var(--accent));
  }
  .project-grid a:hover .project-thumb {
    box-shadow: var(--box-shadow);
  }
  .title-details {
    display: flex;
    justify-content: space-between;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin: 3rem 0;
  }
  .pagination a,
  .pagination span {
    padding: 0.5rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    color: rgb(var(--black));
    font-size: 1rem;
  }
  .pagination a {
    border: 1px solid rgb(var(--gray));
  }
  .pagination a:hover {
    background: rgb(var(--gray-light));
  }
  .pagination .current {
    background: rgb(var(--gray-light));
    color: #fff;
    font-weight: 4ther00;
    outline: 1px solid rgb(var(--gray-light));
    outline-offset: -2px;
  }
  .pagination .disabled {
    opacity: 0.4;
    pointer-events: none;
  }

  @media (max-width: 720px) {
    .project-grid {
      gap: 0.5em;
    }
    .project-grid li {
      width: 100%;
      margin-top: 32px;
    }
    .project-grid li:first-child {
      margin-bottom: 0;
      text-align: left;
    }
    .title {
      font-size: 1.8rem;
      font-family: var(--font-ligema), sans-serif;
      font-weight: 400;
    }
    .title-details {
      margin-top: 1rem;
    }
    .project-grid li:first-child .title {
      font-size: 1.8rem;
      font-weight: 400;
    }
  }
</style>

<ul class="project-grid">
  {
    posts.map((post) => (
      <li>
        <a href={`/projects/${post.id}/`}>
          {post.data.heroImage && (
            <LoadableImage
              class="project-thumb"
              width={392}
              height={360}
              src={post.data.heroImage}
              alt=""
            />
          )}
          <div class="title-details">
            <div>
              <h4 class="title">{post.data.title}</h4>
              <p class="date">
                <FormattedDate date={post.data.pubDate} />
              </p>
            </div>
            <div>
              <svg
                width="34"
                height="34"
                viewBox="0 0 34 34"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M22.3435 20.2204L23.6188 11.7314L15.1298 10.4561"
                  stroke="#CDD1D6"
                  stroke-width="1.5"
                  stroke-miterlimit="10"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M9.94563 21.833L23.4822 11.8325"
                  stroke="#CDD1D6"
                  stroke-width="1.5"
                  stroke-miterlimit="10"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
          </div>
        </a>
      </li>
    ))
  }
</ul>

<div class="pagination">
  {
    currentPage > 1 ? (
      <a
        href={currentPage === 2 ? "/projects" : `/projects/page/${currentPage - 1}`}
        class="prev"
      >
        ← Previous
      </a>
    ) : (
      <span class="disabled">← Previous</span>
    )
  }
  {
    Array.from({ length: totalPages }, (_, i) => i + 1).map((page) =>
      page === currentPage ? (
        <span class="current">{page}</span>
      ) : (
        <a href={page === 1 ? "/projects" : `/projects/page/${page}`}>{page}</a>
      ),
    )
  }
  {
    currentPage < totalPages ? (
      <a href={`/projects/page/${currentPage + 1}`} class="next"
        >Next →</a
      >
    ) : (
      <span class="disabled">Next →</span>
    )
  }
</div>