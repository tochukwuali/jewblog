---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import LoadableImage from "./LoadableImage.astro";

interface Props {
  posts: CollectionEntry<"blog">[];
  currentPage: number;
  totalPages: number;
}

const { posts, currentPage, totalPages } = Astro.props;
---

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    list-style-type: none;
    margin: 0;
    padding: 0;
  }
  .project-grid li {
    width: 100%;
  }
  .project-grid li * {
    text-decoration: none;
    transition: 0.2s ease;
  }
  .project-grid li a {
    display: block;
  }
  .project-grid li .project-thumb {
    width: 100%;
    aspect-ratio: 3 / 4;
    margin-bottom: 1.25rem;
    border-radius: 12px;
  }
  .project-grid li .project-thumb .loadimg__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .project-grid a:hover .project-thumb {
    box-shadow: var(--box-shadow);
  }
  .thumb-wrapper {
    position: relative;
    display: block;
  }
  .substack-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(0, 0, 0, 0.75);
    color: var(--muted);
    font-size: 11px;
    font-weight: 400;
    padding: 4px 10px;
    border-radius: 20px;
    letter-spacing: 0.5px;
    z-index: 2;
  }
  .title-details {
    display: flex;
    flex-direction: column;
    margin-top: 1rem;
  }
  .title {
    margin: 0;
    color: rgb(var(--black));
    line-height: 1.1;
    font-size: 28px;
    font-weight: 400;
    font-family: var(--font-ligema), serif;
    text-transform: uppercase;
  }
  .date {
    margin: 0;
    color: rgb(var(--gray));
    font-size: 12px;
  }
  .project-grid li a:hover .title,
  .project-grid li a:hover .date {
    color: rgb(var(--accent));
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin: 3rem 0;
  }
  .pagination a,
  .pagination span {
    padding: 0.5rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    color: rgb(var(--black));
    font-size: 14px;
  }
  .pagination a {
    border: 1px solid rgb(var(--gray));
  }
  .pagination a:hover {
    background: rgb(var(--gray-light));
  }
  .pagination .current {
    background: rgb(var(--gray-light));
    color: #fff;
    font-weight: 500;
    outline: 1px solid rgb(var(--gray-light));
    outline-offset: -2px;
  }
  .pagination .disabled {
    opacity: 0.4;
    pointer-events: none;
  }

  @media (max-width: 1024px) {
    .project-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 720px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    .title {
      font-size: 28px;
    }
  }
  @media (max-width: 480px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<ul class="project-grid">
  {
    posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`}>
          {post.data.heroImage && (
            <div class="thumb-wrapper">
              <LoadableImage
                class="project-thumb"
                width={392}
                height={360}
                src={post.data.heroImage}
                alt=""
              />
              {post.data.source && (
                <span class="substack-badge">Substack</span>
              )}
            </div>
          )}
          <div class="title-details">
            <h4 class="title">{post.data.title}</h4>
            <p class="date">
              <FormattedDate date={post.data.pubDate} />
            </p>
          </div>
        </a>
      </li>
    ))
  }
</ul>

<div class="pagination">
  {
    currentPage > 1 ? (
      <a
        href={currentPage === 2 ? "/blog" : `/blog/page/${currentPage - 1}`}
        class="prev"
      >
        ← Previous
      </a>
    ) : (
      <span class="disabled">← Previous</span>
    )
  }
  {
    Array.from({ length: totalPages }, (_, i) => i + 1).map((page) =>
      page === currentPage ? (
        <span class="current">{page}</span>
      ) : (
        <a href={page === 1 ? "/blog" : `/blog/page/${page}`}>{page}</a>
      ),
    )
  }
  {
    currentPage < totalPages ? (
      <a href={`/blog/page/${currentPage + 1}`} class="next"
        >Next →</a
      >
    ) : (
      <span class="disabled">Next →</span>
    )
  }
</div>