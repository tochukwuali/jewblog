---
---

<div id="loading-screen" class="loading-screen">
  <div class="sketch-container">
    <!-- Sketch outline of the hero image -->
    <div class="sketch-hero">
      <div class="sketch-hero-inner">
        <span class="sketch-label sketch-label-img">HERO</span>
      </div>
    </div>
    <!-- Sketch title/heading lines -->
    <div class="sketch-text">
      <div class="sketch-line sketch-line-1"></div>
      <div class="sketch-line sketch-line-2"></div>
      <div class="sketch-line sketch-line-3"></div>
    </div>
    <!-- Sketch buttons -->
    <div class="sketch-buttons">
      <div class="sketch-btn"></div>
      <div class="sketch-btn"></div>
    </div>
  </div>
</div>

<style>
  .loading-screen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #0a0a14;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    pointer-events: all;
    transition: opacity 0.6s ease, visibility 0.6s ease;
  }

  .loading-screen.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .sketch-container {
    width: min(90vw, 600px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  /* Hero sketch - dashed outline without card-like outline */
  .sketch-hero {
    width: 100%;
    height: clamp(180px, 40vw, 320px);
    position: relative;
    opacity: 0;
    animation: sketchReveal 0.8s ease-out 0.2s forwards;
  }

  .sketch-hero-inner {
    width: 100%;
    height: 100%;
    border: 2px dashed rgba(255, 255, 255, 0.3);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: sketchDraw 2s linear 0.3s infinite;
  }

  .sketch-label-img {
    font-family: var(--font-ligema), monospace;
    font-size: 2rem;
    color: rgba(255, 255, 255, 0.25);
    letter-spacing: 0.3em;
  }

  /* Title lines */
  .sketch-text {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    opacity: 0;
    animation: sketchReveal 0.8s ease-out 0.5s forwards;
  }

  .sketch-line {
    height: 6px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
  }

  .sketch-line-1 { width: 80%; }
  .sketch-line-2 { width: 60%; }
  .sketch-line-3 { width: 40%; }

  /* Buttons */
  .sketch-buttons {
    width: 100%;
    display: flex;
    gap: 16px;
    opacity: 0;
    animation: sketchReveal 0.8s ease-out 0.8s forwards;
  }

  .sketch-btn {
    flex: 1;
    height: 44px;
    border: 2px dashed rgba(255, 255, 255, 0.3);
    border-radius: 24px;
  }

  @keyframes sketchReveal {
    to {
      opacity: 1;
    }
  }

  @keyframes sketchDraw {
    0% {
      border-color: rgba(255, 255, 255, 0.15);
    }
    50% {
      border-color: rgba(255, 255, 255, 0.4);
    }
    100% {
      border-color: rgba(255, 255, 255, 0.15);
    }
  }
</style>

<script>
  const loadingScreen = document.getElementById('loading-screen');
  const body = document.body;
  const isFirstVisit = !sessionStorage.getItem('visited');

  if (!isFirstVisit) {
    // Skip animation on repeat visits
    loadingScreen?.classList.add('hidden');
    body.classList.remove('loading-screen-active');
  } else {
    // Show sketch animation for ~2.5s then reveal the page
    setTimeout(() => {
      loadingScreen?.classList.add('hidden');
      body.classList.remove('loading-screen-active');
      sessionStorage.setItem('visited', 'true');
    }, 2500);
  }
</script>
