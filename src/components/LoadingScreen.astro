---
---

<div id="loading-screen" class="loading-screen">
  <div class="loading-content">
    <div class="loading-text">
      <h2>Jewbelee</h2>
    </div>
  </div>
</div>

<style>
  .loading-screen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #0a0a14 0%, #0d0d1a 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    animation: fadeOut 1.2s cubic-bezier(0.4, 0, 0.2, 1) 1.8s forwards;
    pointer-events: none;
  }

  .loading-screen.hidden {
    display: none;
  }

  .loading-content {
    text-align: center;
  }

  .loading-text h2 {
    font-size: 3rem;
    color: white;
    margin: 0;
    font-family: var(--font-ligema), sans-serif;
    overflow: hidden;
    white-space: nowrap;
    border-right: 3px solid rgba(255, 255, 255, 0.75);
    animation: typewriter 2s steps(8, end) 0.2s, blink 0.6s step-end infinite 0.2s, fadeOutText 1.2s cubic-bezier(0.4, 0, 0.2, 1) 1.8s forwards;
  }

  @keyframes typewriter {
    from {
      width: 0;
    }
    to {
      width: 8ch;
    }
  }

  @keyframes blink {
    0%, 49% {
      border-right-color: rgba(255, 255, 255, 0.75);
    }
    50%, 100% {
      border-right-color: transparent;
    }
  }

  @keyframes fadeOutText {
    to {
      opacity: 0;
    }
  }

  @keyframes fadeOut {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>

<script>
  // Check if user has visited before
  const isFirstVisit = !sessionStorage.getItem('visited');
  
  if (!isFirstVisit) {
    const loadingScreen = document.getElementById('loading-screen');
    loadingScreen?.classList.add('hidden');
  }

  // Mark as visited after loading screen fades out
  setTimeout(() => {
    sessionStorage.setItem('visited', 'true');
  }, 3100); // Slightly longer than animation duration
</script>
