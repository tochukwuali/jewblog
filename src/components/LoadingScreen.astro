---
---

<div id="loading-screen" class="loading-screen">
  <div class="typewriter-container">
    <p class="typewriter-line">Jewbelee<span class="cursor">|</span></p>
  </div>
</div>

<style>
  .loading-screen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #0a0a14;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    pointer-events: all;
    transition: opacity 0.6s ease, visibility 0.6s ease;
  }

  .loading-screen.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .typewriter-container {
    width: min(90vw, 680px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: #ffffff;
  }

  .typewriter-line {
    font-family: var(--font-ligema), ui-serif, Georgia, serif;
    font-size: clamp(3rem, 6vw, 4.5rem);
    line-height: 1.1;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    border-right: 2px solid rgba(255, 255, 255, 0.8);
    width: 0;
    opacity: 1;
    animation: typing 1.8s steps(8, end) 0.8s forwards;
  }

  .cursor {
    display: inline-block;
    width: 0.8ch;
    animation: blink-caret 0.7s step-end infinite 0.8s;
  }

  @keyframes typing {
    from {
      width: 0;
    }
    to {
      width: 8ch;
    }
  }

  @keyframes blink-caret {
    from,
    to {
      border-color: transparent;
    }
    50% {
      border-color: rgba(255, 255, 255, 0.8);
    }
  }
</style>

<script>
  const loadingScreen = document.getElementById('loading-screen');
  const body = document.body;
  const isFirstVisit = !sessionStorage.getItem('visited');

  if (!isFirstVisit) {
    // Skip animation on repeat visits
    loadingScreen?.classList.add('hidden');
    body.classList.remove('loading-screen-active');
  } else {
    // Show typewriter animation then reveal the page
    setTimeout(() => {
      loadingScreen?.classList.add('hidden');
      body.classList.remove('loading-screen-active');
      sessionStorage.setItem('visited', 'true');
    }, 3200);
  }
</script>
