---
import { Image } from "astro:assets";

type Props = {
  src: Parameters<typeof Image>[0]["src"] | any;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  maxHeight?: number;
  maxWidth?: number;
  class?: string;
  loading?: "eager" | "lazy";
  decoding?: "sync" | "async" | "auto";
  spinner?: boolean;
};

const {
  src,
  alt,
  width,
  height,
  sizes,
  maxHeight,
  maxWidth,
  class: className,
  loading = "lazy",
  decoding = "async",
  spinner = false,
} = Astro.props;

const hasDims = typeof width === "number" && typeof height === "number";
const hasSizes = typeof sizes === "string" && sizes.length > 0;

// Build wrapper style from maxHeight / maxWidth props
const wrapperStyleParts: string[] = [];
if (typeof maxHeight === "number") {
  wrapperStyleParts.push(`--img-max-h:${maxHeight}px`);
}
if (typeof maxWidth === "number") {
  wrapperStyleParts.push(`max-width:${maxWidth}px`);
}
const wrapperStyle = wrapperStyleParts.length > 0 ? wrapperStyleParts.join(";") : undefined;

// Build img style
const imgStyle = "width:auto;object-fit:contain";
---

<div
  class={`loadimg ${className ?? ""}`}
  data-loadimg
  data-spinner={spinner ? "true" : "false"}
  style={wrapperStyle}
>
  <div class="loadimg__placeholder" aria-hidden="true">
    {spinner ? <div class="loadimg__spinner"></div> : null}
  </div>
  {
    hasDims ? (
      hasSizes ? (
        <Image
          src={src}
          alt={alt}
          width={width}
          height={height}
          sizes={sizes}
          loading={loading}
          decoding={decoding}
          class="loadimg__img"
          style={imgStyle}
        />
      ) : (
        <Image
          src={src}
          alt={alt}
          width={width}
          height={height}
          loading={loading}
          decoding={decoding}
          class="loadimg__img"
          style={imgStyle}
        />
      )
    ) : hasSizes ? (
      <Image
        src={src}
        alt={alt}
        sizes={sizes}
        loading={loading}
        decoding={decoding}
        class="loadimg__img"
        style={imgStyle}
        inferSize
      />
    ) : (
      <Image
        src={src}
        alt={alt}
        loading={loading}
        decoding={decoding}
        class="loadimg__img"
        style={imgStyle}
        inferSize
      />
    )
  }
</div>

<style>
  .loadimg .loadimg__img {
    max-height: var(--img-max-h, none);
  }
</style>

<script is:inline>
  (() => {
    if (window.__loadimgInit) return;
    window.__loadimgInit = true;

    const init = (root) => {
      if (!root || root.dataset.loadimgInit) return;
      root.dataset.loadimgInit = "true";

      const img = root.querySelector("img");
      if (!img) return;

      const markLoaded = () => root.classList.add("is-loaded");
      const markError = () => {
        root.classList.add("has-error");
        root.classList.add("is-loaded");
      };

      if (img.complete) {
        if (img.naturalWidth > 0) markLoaded();
        else markError();
        return;
      }

      img.addEventListener("load", markLoaded, { once: true });
      img.addEventListener("error", markError, { once: true });
    };

    const scan = () => document.querySelectorAll("[data-loadimg]").forEach(init);

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", scan, { once: true });
    } else {
      scan();
    }

    const observer = new MutationObserver((mutations) => {
      for (const m of mutations) {
        for (const n of m.addedNodes) {
          if (!(n instanceof Element)) continue;
          if (n.matches?.("[data-loadimg]")) init(n);
          n.querySelectorAll?.("[data-loadimg]").forEach(init);
        }
      }
    });

    observer.observe(document.documentElement, { childList: true, subtree: true });
  })();
</script>